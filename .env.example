# Copy to .env and fill in from Supabase → Project Settings → API.
# Both are exposed in the browser bundle by design: the anon key identifies the
# project, it does not grant access. Row-level security in supabase/schema.sql
# is what protects the data.
#
# Never put the service_role key here — it bypasses row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
